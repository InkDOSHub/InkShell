#!/bin/sh
# apk add clang (item 77): run by apk after it unpacked the YoWASP clang npm package into $1.
# The package has llvm.wasm (one WebAssembly program: clang, wasm-ld, llvm-ar, nm... chosen by the
# name it is run as) and llvm-resources.tar (clang's headers + wasi-libc + libc++ for wasm32-wasip1).
# Makes $1/llvm.wasm, $1/sysroot, $1/bin/<tool> -> llvm.wasm, and the commands in /usr/local/bin;
# prints the paths it made outside $1 (apk del removes them).
set -e
D=${1%/}
cd "$D"
mv package/gen/llvm.core.wasm llvm.wasm
chmod 755 llvm.wasm
mkdir -p sysroot
tar -xf package/gen/llvm-resources.tar -C sysroot
mv package/package.json package/README.md . 2>/dev/null || :
rm -rf package
mkdir -p bin
for t in clang clang++ wasm-ld ar ranlib nm objdump objcopy strip size readelf addr2line c++filt symbolizer; do
  ln -sf ../llvm.wasm "bin/$t"
done
B=/usr/local/bin
# the driver (clang runs the compile in itself, then wasm-ld as a second program)
for t in clang clang++ cc c++; do ln -sf /usr/local/libexec/clang-driver "$B/$t"; echo "$B/$t"; done
ln -sf "$D/bin/wasm-ld" "$B/wasm-ld"; echo "$B/wasm-ld"
for t in ar ranlib nm objdump objcopy strip size readelf addr2line; do
  ln -sf "$D/bin/$t" "$B/llvm-$t"; echo "$B/llvm-$t"
done
ln -sf "$D/bin/c++filt" "$B/llvm-cxxfilt"; echo "$B/llvm-cxxfilt"
# ar and ranlib too: wasm-ld needs the symbol index that busybox ar does not write
for t in ar ranlib; do ln -sf "$D/bin/$t" "$B/$t"; echo "$B/$t"; done
