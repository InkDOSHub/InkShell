# Minimal config for the WebAssembly openssl (apk add openssl; /usr/local/bin/openssl sets OPENSSL_CONF to this
# file unless you set it): "openssl req -x509 -new -key k.pem -subj /CN=name" works without a system config.
# Your own file wins: OPENSSL_CONF=/path openssl ... or openssl req -config /path.
[req]
default_bits = 2048
default_md = sha256
distinguished_name = req_dn
x509_extensions = v3_ca
prompt = no

[req_dn]

[v3_ca]
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid:always,issuer
basicConstraints = critical, CA:true
